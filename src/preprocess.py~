"""
src/preprocess.py
-----------------
Merges all raw datasets into a single unified dataset and engineers
features for regression modelling.

Pipeline:
  1. Load raw CSVs from data/raw/
  2. Align all sources to monthly resolution
     - OWID (annual) is broadcast to every month of that year
  3. Merge on YYYY-MM date string
  4. Clean: replace NOAA sentinels, interpolate short gaps
  5. Engineer features:
     - time_since_1960        (integer months from Jan-1960)
     - co2_growth_rate        (month-over-month delta, ppm)
     - ch4_growth_rate        (month-over-month delta, ppb)
     - co2_12mo_avg           (12-month rolling mean)
     - ch4_12mo_avg
     - tsi_anomaly            (deviation from 1961-1990 baseline mean)
     - volcanic_flag          (binary — 1 during major eruption windows)
     - total_anthropogenic_co2 (sum of sector emissions from OWID)
  6. Drop rows outside 1979-present (overlap of all sources)
  7. Save -> data/processed/merged_dataset.csv

Usage:
  python src/preprocess.py
  or import and call preprocess.run()
"""

import os
import warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore", category=pd.errors.SettingWithCopyWarning)

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RAW_DIR       = os.path.join(PROJECT_ROOT, "data", "raw")
PROCESSED_DIR = os.path.join(PROJECT_ROOT, "data", "processed")


def _raw(filename: str) -> str:
    return os.path.join(RAW_DIR, filename)


# ---------------------------------------------------------------------------
# Known major volcanic eruptions (start_year-month, end_year-month inclusive)
# Sources: Smithsonian GVP / Robock (2000)
# ---------------------------------------------------------------------------
VOLCANIC_WINDOWS = [
    ("1963-03", "1964-06"),  # Agung
    ("1968-05", "1969-03"),  # Fernandina
    ("1974-09", "1975-06"),  # Fuego
    ("1982-04", "1983-12"),  # El Chichón
    ("1991-06", "1993-06"),  # Pinatubo  (strongest 20th-century signal)
]


# ===========================================================================
# Loaders
# ===========================================================================

def load_noaa_co2() -> pd.DataFrame:
    df = pd.read_csv(_raw("noaa_co2_monthly.csv"))
    return df[["date","co2_ppm","co2_deseasonalized"]].copy()


def load_noaa_ch4() -> pd.DataFrame:
    df = pd.read_csv(_raw("noaa_ch4_monthly.csv"))
    return df[["date","ch4_ppb"]].copy()


def load_noaa_n2o() -> pd.DataFrame:
    df = pd.read_csv(_raw("noaa_n2o_monthly.csv"))
    return df[["date","n2o_ppb"]].copy()


def load_nasa_temp() -> pd.DataFrame:
    df = pd.read_csv(_raw("nasa_temp_monthly.csv"))
    return df[["date","temp_anomaly_c"]].copy()


def load_ncei_solar() -> pd.DataFrame:
    df = pd.read_csv(_raw("ncei_solar_monthly.csv"))
    return df[["date","tsi_wm2"]].copy()


def load_owid() -> pd.DataFrame:
    """
    OWID is annual.  Broadcast each year's values to all 12 months
    so we can merge with monthly data on YYYY-MM.
    """
    df = pd.read_csv(_raw("owid_co2_annual.csv"))
    rows = []
    for _, row in df.iterrows():
        for month in range(1, 13):
            r = row.to_dict()
            r["date"] = f"{int(row['year'])}-{str(month).zfill(2)}"
            rows.append(r)
    expanded = pd.DataFrame(rows)
    keep = [c for c in [
        "date","year","co2","methane","nitrous_oxide",
        "land_use_change_co2","cement_co2","coal_co2","oil_co2","gas_co2",
        "total_ghg","energy_per_capita","population","gdp",
    ] if c in expanded.columns]
    return expanded[keep].copy()


# ===========================================================================
# Merge
# ===========================================================================

def merge_all() -> pd.DataFrame:
    print("  Loading raw files ...")
    frames = {
        "co2":   load_noaa_co2(),
        "ch4":   load_noaa_ch4(),
        "n2o":   load_noaa_n2o(),
        "temp":  load_nasa_temp(),
        "solar": load_ncei_solar(),
        "owid":  load_owid(),
    }
    for name, df in frames.items():
        print(f"    {name}: {len(df)} rows")

    # Start with temperature (our target) as the spine
    merged = frames["temp"].copy()
    for name, df in frames.items():
        if name == "temp":
            continue
        merged = merged.merge(df, on="date", how="left")

    # Sort chronologically
    merged = merged.sort_values("date").reset_index(drop=True)
    print(f"  Merged shape: {merged.shape}")
    return merged


# ===========================================================================
# Cleaning
# ===========================================================================

def clean(df: pd.DataFrame) -> pd.DataFrame:
    print("  Cleaning ...")

    # Replace any residual NOAA sentinel values
    sentinel_cols = ["co2_ppm","co2_deseasonalized","ch4_ppb","n2o_ppb","tsi_wm2"]
    for col in sentinel_cols:
        if col in df.columns:
            df[col] = df[col].replace([-999.99, -9.99, -99.99, -999, -9999], np.nan)

    # Interpolate short gaps (≤6 months) in continuous measurement series
    interp_cols = ["co2_ppm","co2_deseasonalized","ch4_ppb","n2o_ppb","tsi_wm2","temp_anomaly_c"]
    for col in interp_cols:
        if col in df.columns:
            null_before = df[col].isna().sum()
            df[col] = df[col].interpolate(method="linear", limit=6, limit_direction="both")
            null_after = df[col].isna().sum()
            if null_before > 0:
                print(f"    Interpolated {null_before - null_after} NaNs in '{col}'")

    # OWID annual features: forward-fill within each year (already broadcast,
    # but handle any edge NaNs from merge)
    owid_cols = ["co2","methane","nitrous_oxide","land_use_change_co2",
                 "cement_co2","coal_co2","oil_co2","gas_co2",
                 "total_ghg","energy_per_capita","population","gdp"]
    for col in owid_cols:
        if col in df.columns:
            df[col] = df[col].fillna(method="ffill").fillna(method="bfill")

    before = len(df)
    df = df.dropna(subset=["temp_anomaly_c", "co2_ppm"])
    print(f"    Dropped {before - len(df)} rows missing target or CO2")
    return df


# ===========================================================================
# Feature Engineering
# ===========================================================================

def engineer_features(df: pd.DataFrame) -> pd.DataFrame:
    print("  Engineering features ...")

    # Parse date parts if not already present
    dt = pd.to_datetime(df["date"])
    if "year" not in df.columns:
        df["year"] = dt.dt.year
    if "month" not in df.columns:
        df["month"] = dt.dt.month

    # 1. Time since baseline (Jan 1960 = 0)
    df["time_since_1960"] = (df["year"] - 1960) * 12 + (df["month"] - 1)

    # 2. CO2 month-over-month growth rate
    df["co2_growth_rate"] = df["co2_ppm"].diff().fillna(0)

    # 3. CH4 month-over-month growth rate
    if "ch4_ppb" in df.columns:
        df["ch4_growth_rate"] = df["ch4_ppb"].diff().fillna(0)

    # 4. 12-month rolling means (smoothed signal)
    df["co2_12mo_avg"] = df["co2_ppm"].rolling(window=12, min_periods=6).mean()
    if "ch4_ppb" in df.columns:
        df["ch4_12mo_avg"] = df["ch4_ppb"].rolling(window=12, min_periods=6).mean()

    # 5. TSI anomaly relative to 1961-1990 baseline
    if "tsi_wm2" in df.columns:
        baseline_mask = (df["year"] >= 1961) & (df["year"] <= 1990)
        tsi_baseline  = df.loc[baseline_mask, "tsi_wm2"].mean()
        df["tsi_anomaly"] = df["tsi_wm2"] - tsi_baseline
        print(f"    TSI baseline (1961-1990 mean): {tsi_baseline:.4f} W/m²")

    # 6. Volcanic activity flag (binary)
    df["volcanic_flag"] = 0
    for start, end in VOLCANIC_WINDOWS:
        mask = (df["date"] >= start) & (df["date"] <= end)
        df.loc[mask, "volcanic_flag"] = 1
    n_volcanic = df["volcanic_flag"].sum()
    print(f"    Flagged {n_volcanic} months as volcanic")

    # 7. Total anthropogenic CO2 from sector sources (OWID)
    sector_cols = [c for c in ["coal_co2","oil_co2","gas_co2","cement_co2","land_use_change_co2"]
                   if c in df.columns]
    if sector_cols:
        df["total_anthropogenic_co2"] = df[sector_cols].sum(axis=1)
        print(f"    total_anthropogenic_co2 = sum of {sector_cols}")
 
    # 8. Drop the OWID 'year' duplicate if it conflicts
    if "year_x" in df.columns:
        df = df.rename(columns={"year_x": "year"}).drop(columns=["year_y"], errors="ignore")
 
    return df
 
 
# ===========================================================================
# Trim to common overlap window
# ===========================================================================
 
def trim_overlap(df: pd.DataFrame, start: str = "1984-01") -> pd.DataFrame:
    """
    Restrict to the period where all major sources overlap.
    NOAA CH4 global starts ~1983; NCEI solar reconstruction starts ~1978.
    Default start: 1984-01 for clean overlap.
    """
    before = len(df)
    df = df[df["date"] >= start].reset_index(drop=True)
    print(f"  Trimmed to {start} onward: {before} -> {len(df)} rows")
    return df
 
 
# ===========================================================================
# Master runner
# ===========================================================================
 
def run() -> pd.DataFrame:
    print("=" * 60)
    print("  Climate Data Preprocessing")
    print("=" * 60)
 
    os.makedirs(PROCESSED_DIR, exist_ok=True)
 
    df = merge_all()
    df = clean(df)
    df = engineer_features(df)
    df = trim_overlap(df)
 
    # Final column report
    print(f"\n  Final dataset: {df.shape[0]} rows x {df.shape[1]} columns")
    print(f"  Date range:   {df['date'].iloc[0]}  ->  {df['date'].iloc[-1]}")
    print(f"  Columns:\n    {list(df.columns)}")
 
    # Save
    out = os.path.join(PROCESSED_DIR, "merged_dataset.csv")
    df.to_csv(out, index=False)
    print(f"\n  Saved -> {out}")
 
    # Show 3 example rows
    print("\n  Example rows (head 3):")
    print(df.head(3).to_string(index=False))
 
    print("\n  Null counts per column:")
    nulls = df.isnull().sum()
    print(nulls[nulls > 0].to_string() if nulls.any() else "    None")
 
    return df
 
 
if __name__ == "__main__":
    run()
 
